# Neon Lakebase Postgres (pulled via `neon deploy` / `neon env pull`)
DATABASE_URL="postgresql://user:password@ep-example-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-example.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Neon Object Storage (S3-compatible, pulled via `neon deploy`)
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_ENDPOINT_URL_S3=""
AWS_REGION=""

# App Auth, Gemini & Stripe
AUTH_SECRET="replace-with-a-random-32-char-secret"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash-lite"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRO_MONTHLY_PRICE_ID=""
STRIPE_PRO_YEARLY_PRICE_ID=""
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_STRIPE_SANDBOX="true"
